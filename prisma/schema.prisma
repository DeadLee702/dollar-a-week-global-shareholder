model ProtocolStateLog {
  id String @id @default(uuid())
  seed_cell_id String
  previous_state String?
  new_state String
  reason String?
  performed_by String?
  created_at DateTime @default(now())

  seedCell SeedCell @relation(fields: [seed_cell_id], references: [id])
}

model InfrastructureAsset {
  id String @id @default(uuid())
  seed_cell_id String
  project_id String?
  asset_type String
  asset_reference String?
  capacity Json?
  commissioning_date DateTime?
  status String @default("PROPOSED")
  metadata Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  seedCell SeedCell @relation(fields: [seed_cell_id], references: [id])
  project Project? @relation(fields: [project_id], references: [id])
}

model ResourceNetwork {
  id String @id @default(uuid())
  seed_cell_id String
  name String?
  description String?
  status String @default("PLANNED")
  metadata Json?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  seedCell SeedCell @relation(fields: [seed_cell_id], references: [id])
}
